    {
      id:    'PUB-LOC-03',
      name:  'Area Sebengkok',
      lat:    3.2988,
      lng:    117.5925,
      level: 'JERNIH',
      updated_at: '2026-09-25T15:00:00.000Z'
    },
    {
      id:    'PUB-LOC-04',
      name:  'Area Juata Laut',
